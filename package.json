{
  "name": "viet-bazi-engine",
  "version": "1.0.0-rc.3",
  "description": "Offline-first, deterministic Bazi/Four Pillars calculation engine for Vietnamese applications.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iZenDeveloper/viet-bazi-engine.git"
  },
  "homepage": "https://github.com/iZenDeveloper/viet-bazi-engine#readme",
  "bugs": {
    "url": "https://github.com/iZenDeveloper/viet-bazi-engine/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "viet-bazi": "dist/cli.js",
    "viet-bazi-mcp": "dist/mcp-server.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas/*": "./schemas/*",
    "./fixtures/v1/manifest.json": "./fixtures/v1/manifest.json",
    "./fixtures/v1/jie-2026.json": "./fixtures/v1/jie-2026.json",
    "./fixtures/v1/jie-multi-year.json": "./fixtures/v1/jie-multi-year.json",
    "./fixtures/v1/jpl-lichun-multi-century.json": "./fixtures/v1/jpl-lichun-multi-century.json",
    "./fixtures/v1/sexagenary-days.json": "./fixtures/v1/sexagenary-days.json",
    "./fixtures/v1/timezone-boundaries.json": "./fixtures/v1/timezone-boundaries.json"
  },
  "files": [
    "api",
    "benchmarks",
    "dist",
    "schemas",
    "fixtures",
    "docs",
    "examples",
    "policy",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && sh scripts/build-wasm.sh && node scripts/export-schemas.mjs",
    "demo": "npm run build && node scripts/serve-demo.mjs",
    "demo:check": "npm run build && node scripts/serve-demo.mjs --check",
    "pages:build": "npm run build && node scripts/prepare-pages.mjs && node scripts/test-pages-artifact.mjs",
    "benchmark": "node scripts/benchmark-batch.mjs",
    "benchmark:reference": "node scripts/benchmark-reference.mjs",
    "ephemeris:generate": "node scripts/generate-jie-ephemeris.mjs",
    "ephemeris:check": "node scripts/generate-jie-ephemeris.mjs --check",
    "test:gauntlet": "node scripts/test-gauntlet.mjs",
    "test:properties": "node scripts/test-properties.mjs",
    "test:mutation": "node scripts/test-mutations.mjs",
    "test:torture": "node scripts/test-torture.mjs",
    "release:check": "npm test && npm run test:python-wheel && node scripts/release-preflight.mjs",
    "release:readiness": "node scripts/check-release-readiness.mjs",
    "release:prepare": "node scripts/prepare-release-version.mjs",
    "test": "npm run ephemeris:check && vitest run && npm run build && npm run test:properties && npm run test:mutation && npm run test:api && node scripts/test-schema-artifacts.mjs && node scripts/test-wasm.mjs && node scripts/test-cli.mjs && node scripts/test-mcp.mjs && node scripts/test-interpretation-pipeline.mjs && node scripts/test-compatibility-policy.mjs && node scripts/test-demo.mjs && node scripts/serve-demo.mjs --check && node scripts/test-demo-server.mjs && node scripts/test-ci-workflow.mjs && node scripts/test-release-version.mjs && node scripts/test-prepare-release-version.mjs && node scripts/test-release-workflow.mjs && node scripts/test-publish-workflow.mjs && node scripts/test-pages-workflow.mjs && node scripts/test-benchmark.mjs && node scripts/test-benchmark-history.mjs && node scripts/test-readme.mjs && npm run test:conformance",
    "test:unit": "vitest run",
    "test:api": "node scripts/audit-public-api.mjs",
    "test:wasm": "npm run build && node scripts/test-wasm.mjs",
    "test:conformance": "node scripts/verify-conformance.mjs",
    "test:mcp": "npm run build && node scripts/test-mcp.mjs",
    "test:interpretation": "npm run build && node scripts/test-interpretation-pipeline.mjs",
    "test:policy": "node scripts/test-compatibility-policy.mjs",
    "test:e2e": "playwright test",
    "sync:python": "npm run build && node scripts/sync-python-engine.mjs",
    "test:python-wheel": "npm run sync:python && sh scripts/test-python-wheel.sh",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "bazi",
    "four-pillars",
    "tứ-trụ",
    "vietnamese-astrology",
    "typescript",
    "wasm",
    "offline",
    "mcp"
  ],
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "assemblyscript": "^0.28.8",
    "astronomy-engine": "^2.1.19",
    "lunar-typescript": "^1.8.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
